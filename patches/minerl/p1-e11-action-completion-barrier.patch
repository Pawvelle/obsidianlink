+    private static long armE11FlintAndSteelCompletionBarrier() {
+        synchronized (E11_ACTION_COMPLETION_MONITOR) {
+            if (e11ActionCompletionPendingGeneration != 0L) {
+                throw new IllegalStateException("E11 flint-and-steel completion barrier is already pending");
+            }
+            e11ActionCompletionPendingGeneration = ++e11ActionCompletionGeneration;
+            return e11ActionCompletionPendingGeneration;
+        }
+    }
+
+    public static boolean isE11FlintAndSteelCompletionBarrierPending() {
+        synchronized (E11_ACTION_COMPLETION_MONITOR) {
+            return e11ActionCompletionPendingGeneration != 0L;
+        }
+    }
+
+    public static void completeE11FlintAndSteelCompletionBarrier() {
+        synchronized (E11_ACTION_COMPLETION_MONITOR) {
+            if (e11ActionCompletionPendingGeneration != 0L) {
+                e11ActionCompletionCompletedGeneration = e11ActionCompletionPendingGeneration;
+                e11ActionCompletionPendingGeneration = 0L;
+                E11_ACTION_COMPLETION_MONITOR.notifyAll();
+            }
+        }
+    }
+
+    private static void awaitE11FlintAndSteelCompletionBarrier(long generation) {
+        long deadline = System.nanoTime() + E11_ACTION_COMPLETION_TIMEOUT_NANOS;
+        synchronized (E11_ACTION_COMPLETION_MONITOR) {
+            while (e11ActionCompletionCompletedGeneration < generation) {
+                long remaining = deadline - System.nanoTime();
+                if (remaining <= 0L) {
+                    if (e11ActionCompletionPendingGeneration == generation) {
+                        e11ActionCompletionPendingGeneration = 0L;
+                        E11_ACTION_COMPLETION_MONITOR.notifyAll();
+                    }
+                    throw new IllegalStateException("E11 flint-and-steel server action completion timed out");
+                }
+                try {
+                    TimeUnit.NANOSECONDS.timedWait(E11_ACTION_COMPLETION_MONITOR, remaining);
+                } catch (InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                    throw new RuntimeException("E11 flint-and-steel completion barrier interrupted", exception);
+                }
+            }
+        }
+    }
