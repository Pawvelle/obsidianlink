+    private void prepareControlledBuildArea(Minecraft mc, MissionInit missionInit) {
+        Object worldGenerator = missionInit.getMission().getServerSection()
+                .getServerHandlers().getWorldGenerator();
+        PosAndDirection startPos = getAgentStart(missionInit).getPlacement();
+        MinecraftServer server = mc.getIntegratedServer();
+        if (!(worldGenerator instanceof FlatWorldGenerator)
+                || startPos == null
+                || server == null) {
+            return;
+        }
+        server.execute(() -> {
+            ServerWorld world = server.getWorld(World.OVERWORLD);
+            if (world == null) {
+                throw new IllegalStateException("Overworld is unavailable");
+            }
+            int centerX = (int) Math.floor(startPos.getX());
+            int feetY = (int) Math.floor(startPos.getY());
+            int centerZ = (int) Math.floor(startPos.getZ());
+            int radius = 12;
+            for (int x = centerX - radius; x <= centerX + radius; x++) {
+                for (int z = centerZ - radius; z <= centerZ + radius; z++) {
+                    world.setBlockState(
+                            new BlockPos(x, feetY - 4, z),
+                            Blocks.BEDROCK.getDefaultState(),
+                            2);
+                    world.setBlockState(
+                            new BlockPos(x, feetY - 3, z),
+                            Blocks.DIRT.getDefaultState(),
+                            2);
+                    world.setBlockState(
+                            new BlockPos(x, feetY - 2, z),
+                            Blocks.DIRT.getDefaultState(),
+                            2);
+                    world.setBlockState(
+                            new BlockPos(x, feetY - 1, z),
+                            Blocks.GRASS_BLOCK.getDefaultState(),
+                            2);
+                    for (int y = feetY; y <= feetY + 8; y++) {
+                        world.setBlockState(
+                                new BlockPos(x, y, z),
+                                Blocks.AIR.getDefaultState(),
+                                2);
+                    }
+                }
+            }
+            world.func_241124_a__(
+                    new BlockPos(centerX, feetY, centerZ),
+                    startPos.getYaw());
+        });
