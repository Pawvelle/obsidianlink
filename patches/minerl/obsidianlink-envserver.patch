+    private void applyServerInitialConditions(Minecraft mc, MissionInit missionInit) {
+        MinecraftServer server = mc.getIntegratedServer();
+        ServerInitialConditions conditions = getServerInit(missionInit);
+        if (server == null || conditions == null) {
+            return;
+        }
+        server.execute(() -> {
+            for (ServerWorld world : server.getWorlds()) {
+                Time time = conditions.getTime();
+                if (time != null) {
+                    if (time.getStartTime() != null) {
+                        world.setDayTime(time.getStartTime());
+                    }
+                    if (time.isAllowPassageOfTime() != null) {
+                        world.getGameRules().get(GameRules.DO_DAYLIGHT_CYCLE)
+                                .set(time.isAllowPassageOfTime(), server);
+                    }
+                }
+                if (conditions.isAllowSpawning() != null) {
+                    world.getGameRules().get(GameRules.DO_MOB_SPAWNING)
+                            .set(conditions.isAllowSpawning(), server);
+                }
+                String weather = conditions.getWeather();
+                if ("clear".equals(weather)) {
+                    world.func_241113_a_(1000000000, 0, false, false);
+                    world.getGameRules().get(GameRules.DO_WEATHER_CYCLE)
+                            .set(false, server);
+                } else if ("rain".equals(weather)) {
+                    world.func_241113_a_(0, 1000000000, true, false);
+                } else if ("thunder".equals(weather)) {
+                    world.func_241113_a_(0, 1000000000, true, true);
+                }
+            }
+        });
+    }
