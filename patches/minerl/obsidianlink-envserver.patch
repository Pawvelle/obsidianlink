+    private void addGridObservations(
+            JsonObject infoJson,
+            ClientPlayerEntity player,
+            ObservationFromGrid observation) {
+        for (GridDefinition grid : observation.getGrid()) {
+            if (grid.isProjectDown()) {
+                LOGGER.warn(
+                        "ObservationFromGrid projectDown is not supported by "
+                                + "the MineRL EnvServer bridge: " + grid.getName());
+                continue;
+            }
+            BlockPos origin;
+            if (grid.isAbsoluteCoords()) {
+                origin = BlockPos.ZERO;
+            } else if (grid.isAtSpawn()) {
+                origin = getMissionSpawnOrigin(player);
+            } else {
+                origin = player.getPosition();
+            }
+            int xMin = origin.getX() + (int) Math.floor(grid.getMin().getX());
+            int xMax = origin.getX() + (int) Math.floor(grid.getMax().getX());
+            int yMin = origin.getY() + (int) Math.floor(grid.getMin().getY());
+            int yMax = origin.getY() + (int) Math.floor(grid.getMax().getY());
+            int zMin = origin.getZ() + (int) Math.floor(grid.getMin().getZ());
+            int zMax = origin.getZ() + (int) Math.floor(grid.getMax().getZ());
+            JsonArray blocks = new JsonArray();
+            for (int y = yMin; y <= yMax; y++) {
+                for (int z = zMin; z <= zMax; z++) {
+                    for (int x = xMin; x <= xMax; x++) {
+                        BlockPos position = new BlockPos(x, y, z);
+                        blocks.add(
+                                Registry.BLOCK.getKey(
+                                        player.world.getBlockState(position)
+                                                .getBlock())
+                                        .toString());
+                    }
+                }
+            }
+            infoJson.add(grid.getName(), blocks);
+        }
+    }
+
+    private BlockPos getMissionSpawnOrigin(ClientPlayerEntity player) {
+        PosAndDirection startPos = getAgentStart(missionInit).getPlacement();
+        if (startPos != null) {
+            return new BlockPos(
+                    Math.floor(startPos.getX()),
+                    Math.floor(startPos.getY()),
+                    Math.floor(startPos.getZ()));
+        }
+        MinecraftServer server = Minecraft.getInstance().getIntegratedServer();
+        if (server != null) {
+            ServerWorld world = server.getWorld(player.world.getDimensionKey());
+            if (world != null) {
+                return world.getSpawnPoint();
+            }
+        }
+        return player.getPosition();
+    }
