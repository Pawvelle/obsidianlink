+    private static boolean queueFlintAndSteelUseToServerThread(String actions) {
+        if (!actionRequestsUse(actions)) {
+            return false;
+        }
+        Minecraft mc = Minecraft.getInstance();
+        MinecraftServer server = mc.getIntegratedServer();
+        boolean clientHoldsFlint = mc.player != null
+                && !mc.player.getHeldItemMainhand().isEmpty()
+                && mc.player.getHeldItemMainhand().getItem() == Items.FLINT_AND_STEEL;
+        if (server == null) {
+            if (clientHoldsFlint) {
+                throw new IllegalStateException(
+                        "flint_and_steel use could not be marshaled onto the integrated server thread");
+            }
+            return false;
+        }
+        if (pendingFlintAndSteelMarshal.get() != null) {
+            throw new IllegalStateException(
+                    "previous flint_and_steel marshal is still pending");
+        }
+        CompletableFuture<Boolean> done = new CompletableFuture<Boolean>();
+        LOGGER.info(
+                "[E11-MARSHAL] queued flint_and_steel processRightClickBlock from thread={}",
+                Thread.currentThread().getName());
+        server.execute(() -> {
+            try {
+                boolean applied = false;
+                for (ServerPlayerEntity player : server.getPlayerList().getPlayers()) {
+                    ItemStack stack = player.getHeldItemMainhand();
+                    if (stack.isEmpty() || stack.getItem() != Items.FLINT_AND_STEEL) {
+                        continue;
+                    }
+                    ServerWorld world = player.getServerWorld();
+                    RayTraceResult raw = player.pick(4.5D, 1.0F, false);
+                    if (!(raw instanceof BlockRayTraceResult)
+                            || raw.getType() != RayTraceResult.Type.BLOCK) {
+                        continue;
+                    }
+                    BlockRayTraceResult hit = (BlockRayTraceResult) raw;
+                    LOGGER.info(
+                            "[E11-MARSHAL] flint_and_steel processRightClickBlock thread={} worldClass={} isRemote={} hit={}",
+                            Thread.currentThread().getName(),
+                            world.getClass().getName(),
+                            world.isRemote,
+                            hit.getPos());
+                    player.interactionManager.func_219441_a(
+                            player,
+                            world,
+                            stack,
+                            Hand.MAIN_HAND,
+                            hit);
+                    applied = true;
+                }
+                done.complete(applied);
+            } catch (Throwable error) {
+                done.completeExceptionally(error);
+            }
+        });
+        pendingFlintAndSteelMarshal.set(done);
+        return true;
+    }
+
+    private static void awaitPendingFlintAndSteelMarshal() {
+        CompletableFuture<Boolean> done = pendingFlintAndSteelMarshal.getAndSet(null);
+        if (done == null) {
+            return;
+        }
+        try {
+            Boolean applied = done.get(30L, TimeUnit.SECONDS);
+            if (!Boolean.TRUE.equals(applied)) {
+                throw new IllegalStateException(
+                        "flint_and_steel use was not applied on the integrated server thread");
+            }
+        } catch (TimeoutException timeout) {
+            throw new IllegalStateException(
+                    "flint_and_steel server-thread marshal timed out", timeout);
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(
+                    "flint_and_steel server-thread marshal interrupted", interrupted);
+        } catch (ExecutionException execution) {
+            Throwable cause = execution.getCause();
+            if (cause instanceof RuntimeException) {
+                throw (RuntimeException) cause;
+            }
+            throw new IllegalStateException(
+                    "flint_and_steel server-thread marshal failed", cause);
+        }
+    }
