+    private static boolean actionRequestsUse(String actions) {
+        for (String action: actions.split("\n")) {
+            String[] splitAction = action.trim().split(" ");
+            if (splitAction[0].equals("use")
+                    && splitAction.length > 1
+                    && Integer.parseInt(splitAction[1]) == 1) {
+                return true;
+            }
+        }
+        return false;
+    }
