{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidianlink.local/schemas/task_instance.schema.json",
  "title": "ObsidianLink TaskInstance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route",
    "difficulty",
    "agent_ids",
    "world_seed",
    "instruction",
    "spawn_positions",
    "initial_inventories",
    "workflow",
    "milestones",
    "limits",
    "split"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": [
        "obsidian_mining",
        "lava_casting"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "agent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "world_seed": {
      "type": "integer"
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "spawn_positions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {"type": "integer"},
          {"type": "integer"},
          {"type": "integer"}
        ],
        "items": false
      }
    },
    "initial_inventories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_environment_steps",
        "max_model_calls",
        "max_game_time_seconds"
      ],
      "properties": {
        "max_environment_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_game_time_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "split": {
      "enum": [
        "development",
        "train",
        "validation",
        "test"
      ]
    }
  }
}
