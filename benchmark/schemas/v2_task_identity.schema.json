{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidianlink.local/schemas/v2_task_identity.schema.json",
  "title": "ObsidianLink v2 Task Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_instance_id",
    "family",
    "suite",
    "mode",
    "level",
    "layout"
  ],
  "properties": {
    "task_instance_id": {"type": "string", "minLength": 1},
    "family": {"const": "nether_portal_construction"},
    "suite": {
      "enum": ["diagnostic", "end_to_end", "generalization_recovery"]
    },
    "mode": {"enum": ["single", "multi"]},
    "level": {"pattern": "^(D[1-6]|P[1-4])$"},
    "layout": {"enum": ["controlled", "randomized", "hidden", "challenge"]}
  },
  "allOf": [
    {
      "if": {"properties": {"suite": {"const": "diagnostic"}}},
      "then": {"properties": {"level": {"pattern": "^D[1-6]$"}}},
      "else": {"properties": {"level": {"pattern": "^P[1-4]$"}}}
    }
  ]
}
