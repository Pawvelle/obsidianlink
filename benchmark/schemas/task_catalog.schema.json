{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidianlink.local/schemas/task_catalog.schema.json",
  "title": "ObsidianLink v2 Compatibility Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "active_phase",
    "active_benchmark_task_id",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "catalog_version": {"type": "string", "minLength": 1},
    "active_phase": {"const": "P1-REAL-MINERL-ENVIRONMENT-VALIDATION"},
    "active_benchmark_task_id": {"type": "null"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "legacy_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_family", "agent_mode", "task_level", "layout_type"],
      "properties": {
        "task_family": {"const": "casting"},
        "agent_mode": {"enum": ["single", "multi"]},
        "task_level": {"pattern": "^C[1-5]$"},
        "layout_type": {"enum": ["fixed", "randomized", "hidden", "challenge"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "canonical_name",
        "compatibility_id",
        "task_instance_id",
        "workflow",
        "taxonomy",
        "instance_path",
        "experiment_paths",
        "implementation_status",
        "verification_level",
        "benchmark_visible",
        "live_run_allowed"
      ],
      "properties": {
        "kind": {"enum": ["legacy", "calibration"]},
        "canonical_name": {"type": "string", "minLength": 1},
        "compatibility_id": {"type": "string", "minLength": 1},
        "task_instance_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "taxonomy": {
          "oneOf": [
            {"$ref": "#/$defs/legacy_taxonomy"},
            {"type": "null"}
          ]
        },
        "instance_path": {"type": "string", "pattern": "^[^/].*\\.json$"},
        "experiment_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^/].*\\.json$"}
        },
        "implementation_status": {"const": "legacy_regression"},
        "verification_level": {"const": "unit_verified"},
        "benchmark_visible": {"const": false},
        "live_run_allowed": {"const": false}
      }
    }
  }
}
