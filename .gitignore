.DS_Store
.env
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.venv/
build/
dist/
*.egg-info/

# Local IDE / editor configs that should not enter the research skeleton.
/.vscode/
/.idea/

# Local caches that are not part of the research skeleton.
/models/
/runs/
/logs/
/results/
/vendor/
obsidianlink/logs/

# Live experiment raw outputs stay on the local machine.
# Git tracks experiment scripts, HISTORY.md, and small evidence
# summaries — not JSON traces or PNG frames.
obsidianlink/experiments/runs/*
!obsidianlink/experiments/runs/.gitkeep
obsidianlink/experiments/episodes/*
!obsidianlink/experiments/episodes/.gitkeep
